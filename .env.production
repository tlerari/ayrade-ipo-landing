# =====================================================================
# AYRADE IPO — Variables d'environnement de PRODUCTION
# =====================================================================
# Ce fichier est chargé automatiquement par Next.js lors d'un `next build`
# (mode production). Il EST committé dans le dépôt : il ne contient que des
# flags publics non sensibles (préfixe NEXT_PUBLIC_*).
#
# Les secrets (mots de passe, tokens) restent dans .env.local (gitignored).
# =====================================================================

# ── Notice d'information COSOB ───────────────────────────────────────
# Notice visée publiée le 26/05/2026 (v2 visa-approved, 85 pages).
# `true` => bascule V1 -> V2 : CTA "Télécharger la notice" actif partout
# (DataRoom, KeyFigures, Footer), bodies HowTo step1/2/3 en version pleine,
# FAQ étendue, lead non-teaser sur les pages légales.
NEXT_PUBLIC_NOTICE_PUBLISHED=true

# ── Plaquette investisseurs ──────────────────────────────────────────
# Gate dédié, décorrélé de la notice (décision client 26/05/2026).
# Passer à `true` lorsque le PDF sera livré et placé dans
# public/documents/plaquette-investisseurs-ayrade.pdf.
NEXT_PUBLIC_PLAQUETTE_PUBLISHED=false
