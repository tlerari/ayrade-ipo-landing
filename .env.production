# =====================================================================
# AYRADE IPO — Variables d'environnement de PRODUCTION
# =====================================================================
# Ce fichier est chargé automatiquement par Next.js lors d'un `next build`
# (mode production). Il EST committé dans le dépôt : il ne contient que des
# flags publics non sensibles (préfixe NEXT_PUBLIC_*).
#
# Les secrets (mots de passe, tokens) restent dans .env.local (gitignored).
# =====================================================================

# ── Notice d'information COSOB ───────────────────────────────────────
# Notice visée publiée le 26/05/2026 (v2 visa-approved, 85 pages).
# `true` => bascule V1 -> V2 : CTA "Télécharger la notice" actif partout
# (DataRoom, KeyFigures, Footer), bodies HowTo step1/2/3 en version pleine,
# FAQ étendue, lead non-teaser sur les pages légales.
NEXT_PUBLIC_NOTICE_PUBLISHED=true

# ── Plaquette investisseurs (dépliant 2 pages) ───────────────────────
# Document livré le 02/06/2026 sous forme de dépliant Adobe Illustrator,
# placé à public/documents/plaquette-investisseurs-ayrade.pdf.
# `true` => activation dans la DataRoom + dans le bandeau Hero (CTA droit
# en phase souscription).
NEXT_PUBLIC_PLAQUETTE_PUBLISHED=true

# ── Film institutionnel AYRADE (YouTube) ─────────────────────────────
# ID de la vidéo YouTube embarquée dans la section RespirationBand
# (« Découvrir AYRADE »). Vidéo lue en lightbox via youtube-nocookie.com
# (privacy-enhanced, déjà autorisé dans la CSP du vhost nginx).
# Vide ou absent => bouton play désactivé (placeholder « bientôt en ligne »).
NEXT_PUBLIC_YOUTUBE_ID=Z8Ho5xzYTFQ
